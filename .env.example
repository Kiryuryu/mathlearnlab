# MathLearnLab 环境变量示例
# 复制此文件为 .env 并填入实际值，不要将 .env 提交到 Git

# ── 调试模式 ──
# 开发环境设为 true，生产环境必须为 false
DEBUG=false

# ── JWT 签名密钥（生产环境必填） ──
# 使用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
# 生产环境未设置时将拒绝启动
JWT_SECRET_KEY=

# ── 管理员密钥（用于 /admin 页面登录） ──
# 建议与 JWT_SECRET_KEY 同样长度，不要使用默认值
# 生产环境未设置时将拒绝启动（通过 Authorization: Bearer <secret> 头传递）
ADMIN_SECRET=

# ── AI Provider：DeepSeek ──
# DeepSeek API Key（OpenAI 兼容端点）
DEEPSEEK_API_KEY=

# ── AI 配额与限制 ──
# 每个用户每天可调用的 AI 次数（出题/批改/聊天），持久化在数据库
AI_DAILY_LIMIT=60
# 批改接口允许的最大图片大小（字节），默认 5MB
MAX_IMAGE_BYTES=5242880

# ── 默认模型 ──
# 可选：deepseek-chat, deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# ── 数据库 ──
# 留空则使用 SQLite；MySQL 格式：mysql://user:password@host/dbname
# 请替换为自己的真实凭据，勿在仓库中提交真实密码
DATABASE_URL=mysql://user:password@localhost/mathlearnlab

# ── CORS 允许的来源（逗号分隔） ──
# 生产环境建议只保留你的域名
CORS_ORIGINS=https://mathlearnlab.cn,https://www.mathlearnlab.cn,http://127.0.0.1:5173,http://127.0.0.1:8000

# ── 邮件通知（用户注册审核） ──
SMTP_HOST=smtp.163.com
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# ── 内容路径 ──
CONTENT_DIR=content
DATA_DIR=data
